{
  "name": "leleblog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static personal blog built with Node.js, no framework.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs",
    "clean": "node scripts/clean.mjs",
    "check": "node scripts/check-links.mjs",
    "verify": "node scripts/build.mjs && node scripts/check-links.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "markdown-it": "14.1.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-strikethrough-alt": "^1.0.0",
    "markdown-it-texmath": "^1.0.0"
  }
}
